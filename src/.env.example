# Banco de Dados PostgreSQL (Conexão da Aplicação — Role sem BYPASSRLS)
# @spec SPEC-01, @rnf RNF-11, @rnf RNF-30
DATABASE_URL="postgresql://tradepilot_app:tradepilot_app_dev_password@localhost:5432/tradepilot_db?schema=public"

# Conexão Administrativa (somente para migrations Prisma/SQL)
DIRECT_ADMIN_DATABASE_URL="postgresql://tradepilot_admin:tradepilot_admin_dev_password@localhost:5432/tradepilot_db?schema=public"

# Autenticação JWT (@spec SPEC-01, @rf RF-T-1, @rnf RNF-12)
JWT_SECRET="substitua-por-segredo-forte-com-no-minimo-32-caracteres"
JWT_ISSUER="tradepilot-ai"
JWT_AUDIENCE="tradepilot-ai-web"
JWT_ACCESS_TTL_SECONDS=900

# API Server
API_PORT=3001
NODE_ENV="development"

# Frontend Next.js (@spec SPEC-18)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
